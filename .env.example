DATABASE_URL=sqlite:///./requiem.db         # or a Neon postgres URL
SESSION_SECRET=change-me                     # any long random string

LLM_MODE=record                              # live | record (call + save replies) | replay (offline, demo day)
LLM_PRIMARY=gemini                           # gemini | groq; the other one is the fallback
GEMINI_API_KEY=                              # https://aistudio.google.com/apikey
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=gemini-3.8-flash                # never leave empty: an empty value overrides the code default
GROQ_API_KEY=                                # https://console.groq.com/keys
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b           # never leave empty
GROQ_BACKUP_MODELS=qwen/qwen3.8-27b,openai/gpt-oss-20b   # tried in order when GROQ_MODEL hits its rate limit (limits are per model)
GROQ_WHISPER_MODEL=whisper-large-v3-turbo    # stretch: voice
LLM_TIMEOUT_S=45

OSM_LIVE=0                                   # 1 = fetch competitor counts from Overpass per report (cached 24h); 0 = use data/osm/niphad_counts.json
